{
  "manifest_version": 3,
  "name": "YouTube Video Speed Enhancer",
  "short_name": "YT Speed",
  "version": "3.0.0",
  "version_name": "3.0.0 RC1",
  "minimum_chrome_version": "111",
  "description": "Reliable YouTube playback speed control from 0.25x to 16x with presets, keyboard shortcuts, persistent settings, and a dual-world player engine.",
  "icons": {
    "16": "assets/youtube_video_speed_icon.png",
    "48": "assets/youtube_video_speed_icon.png",
    "128": "assets/youtube_video_speed_icon.png"
  },
  "permissions": [
    "storage"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://*.youtube.com/*"
      ],
      "js": [
        "player-main.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://*.youtube.com/*"
      ],
      "js": [
        "youtube_speed_change.js"
      ],
      "run_at": "document_start",
      "world": "ISOLATED"
    }
  ],
  "action": {
    "default_title": "YouTube Video Speed Enhancer",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "assets/youtube_video_speed_icon.png",
      "48": "assets/youtube_video_speed_icon.png",
      "128": "assets/youtube_video_speed_icon.png"
    }
  }
}
